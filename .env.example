ENVIRONMENT=development
DEBUG=true

SECRET_KEY=changeme-generate-a-secure-random-key-min-16-chars

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_PREFIX=vidur_project_

CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION_PREFIX=vidur_project_

LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Ollama runs as a separate local service (like Mongo/ChromaDB), not a pip
# dependency. These match the code defaults in backend/app/config/settings.py,
# so they're optional here - listed for clarity.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=120.0

# Feature flags (backend/app/config/feature_flags.py). All MINOR_* default
# True, all MAJOR_* default False per Articles 41-44; override here to
# activate a Major capability locally with zero code changes.
MINOR_PROJECT_INSPECTION=true
MINOR_AI_REASONING=true
MINOR_REQUIREMENT_CONSISTENCY=true
MINOR_ARCHITECTURE_CONSISTENCY=true
MINOR_PROJECT_MEMORY=true
MINOR_BASIC_ANALYTICS=true

MAJOR_DEEP_LEARNING_VISUAL_INSPECTION=false
MAJOR_ML_RISK_PREDICTION=false
MAJOR_IOT_ENVIRONMENTAL_ANALYTICS=false
MAJOR_ADVANCED_NLP_DOCUMENT_REASONING=false
MAJOR_PREDICTIVE_DASHBOARDS=false
